source "https://rubygems.org"

# The site generator. GitHub installs this automatically when it builds the site.
gem "jekyll", "~> 4.4"

# Standard libraries that newer Ruby versions no longer bundle.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Only needed to preview the site on your own computer (bundle exec jekyll serve).
gem "webrick"
